# Copiar a .env. Las contraseñas de BD salen de infrastructure/local/.env (PG_APP_PASSWORD).
SJI_PG_HOST=localhost
SJI_PG_PORT=5433
SJI_PG_DB=sji
SJI_PG_PASSWORD=cambia-app-local
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
SJI_JWT_CLAVE=cambia-esta-clave-jwt-de-al-menos-32-caracteres
# Llave AES-256 en base64 (32 bytes) para contenido ODR cifrado: openssl rand -base64 32
SJI_LLAVE_CIFRADO=
SJI_ORIGEN_WEB=http://localhost:5173
# Almacén S3 (RustFS): S3_ACCESS_KEY y S3_SECRET_KEY de infrastructure/local/.env
SJI_S3_ACCESS_KEY=
SJI_S3_SECRET_KEY=
# Servicio de IA (mismo secreto que IA_SERVICIO_TOKEN de ia-service)
SJI_IA_URL=http://localhost:8001
SJI_IA_TOKEN=
